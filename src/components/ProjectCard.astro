---
import type { ProjectData } from "../types/project";

interface Props {
  project: ProjectData;
  viewCode: string;
  viewLive: string;
}

const { project, viewCode, viewLive } = Astro.props;
const { title, description, tech, links } = project;
---

<article class="rounded-lg border border-gray-200 bg-white p-6 transition-colors dark:border-white/5 dark:bg-gray-900">
  <h3 class="mb-2 text-xl font-semibold">{title}</h3>
  <p class="mb-4 text-gray-600 dark:text-gray-400">{description}</p>
  <div class="mb-4 flex flex-wrap gap-2">
    {
      tech.map((t) => (
        <span class="rounded-lg bg-indigo-100 px-2 py-1 text-xs font-medium text-indigo-700 dark:bg-purple-950 dark:text-purple-300">
          {t}
        </span>
      ))
    }
  </div>
  <div class="flex gap-3">
    {
      (links.github || links.forgejo) && (
        <a
          href={links.github || links.forgejo}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-indigo-600 transition-colors hover:text-indigo-800 dark:text-purple-400 dark:hover:text-purple-300"
        >
          {viewCode}
        </a>
      )
    }
    {
      links.live && (
        <a
          href={links.live}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-indigo-600 transition-colors hover:text-indigo-800 dark:text-purple-400 dark:hover:text-purple-300"
        >
          {viewLive}
        </a>
      )
    }
  </div>
</article>
