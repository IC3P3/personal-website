---
import ThemeToggle from "./ThemeToggle.astro";
import type { NavContent } from "../types/navbar";

interface Props {
    content: NavContent;
}
const { content } = Astro.props;
---

<nav
    class="fixed top-3 left-1/2 z-50 w-[calc(100%-1.5rem)] max-w-5xl -translate-x-1/2 rounded-lg border border-gray-200/50 bg-white/70 backdrop-blur-lg dark:border-white/5 dark:bg-gray-900/70"
>
    <div class="h-navbar mx-auto flex items-center justify-between px-5">
        <a
            href="/"
            class="text-lg font-semibold text-gray-900 dark:text-gray-100"
        >
            {content.title}
        </a>

        <div class="hidden items-center gap-1 md:flex">
            {
                content.items.map((item) => (
                    <a
                        href={item.link}
                        class="rounded-lg px-4 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-indigo-100 hover:text-indigo-700 dark:text-gray-300 dark:hover:bg-purple-950 dark:hover:text-purple-400"
                    >
                        {item.title}
                    </a>
                ))
            }
        </div>

        <div class="flex items-center gap-2">
            <ThemeToggle />
            <button
                id="mobile-menu-btn"
                class="rounded-lg p-3 text-gray-600 transition-colors hover:bg-gray-200 md:hidden dark:text-gray-300 dark:hover:bg-gray-800"
                aria-label="Menu"
            >
                <svg
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>
    </div>
</nav>

<div
    id="mobile-menu"
    class="invisible fixed inset-0 z-100 flex flex-col bg-white opacity-0 transition-all duration-300 dark:bg-gray-950"
>
    <div class="flex items-center justify-end px-5 pt-5">
        <button
            id="mobile-menu-close"
            class="rounded-lg p-3 text-gray-600 hover:bg-gray-200 dark:text-gray-300 dark:hover:bg-gray-800"
            aria-label="Menu schließen"
        >
            <svg
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
            >
                <path d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>
    <div class="flex flex-1 flex-col items-center justify-center gap-8">
        {
            content.items.map((item) => (
                <a
                    href={item.link}
                    class="mobile-menu-link rounded-lg px-6 py-3 text-3xl font-medium text-gray-700 transition-colors hover:bg-indigo-50 hover:text-indigo-600 dark:text-gray-200 dark:hover:bg-purple-950 dark:hover:text-purple-400"
                >
                    {item.title}
                </a>
            ))
        }
    </div>
</div>

<script>
    const btn = document.getElementById("mobile-menu-btn");
    const closeBtn = document.getElementById("mobile-menu-close");
    const menu = document.getElementById("mobile-menu");

    if (import.meta.env.DEV && (!btn || !closeBtn || !menu))
        throw new Error("Mobile menu elements not found");

    /* eslint-disable @typescript-eslint/no-non-null-assertion */
    const safeBtn = btn!;
    const safeCloseBtn = closeBtn!;
    const safeMenu = menu!;
    /* eslint-enable @typescript-eslint/no-non-null-assertion */

    function openMenu() {
        safeMenu.classList.remove("invisible", "opacity-0");
    }

    function closeMenu() {
        safeMenu.classList.add("invisible", "opacity-0");
    }

    safeBtn.addEventListener("click", openMenu);
    safeCloseBtn.addEventListener("click", closeMenu);

    document.querySelectorAll(".mobile-menu-link").forEach((link) => {
        link.addEventListener("click", closeMenu);
    });
</script>
