---
import fs from "node:fs";

const { link, type } = Astro.props;
const svg = fs.readFileSync(`public/socials/${type}.svg`, "utf-8");
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class="rounded-full p-3 items-center text-gray-500 transition-colors duration-300 hover:bg-purple-100 hover:text-purple-700 dark:text-gray-400 dark:hover:bg-purple-950 dark:hover:text-purple-400"
  aria-label={`${type} logo`}
>
  <Fragment set:html={svg} />
</a>
