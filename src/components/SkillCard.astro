---
import type { CollectionEntry } from "astro:content";

interface Props {
    skill: CollectionEntry<"skills">["data"];
    locale: string;
    learningLabel: string;
}

const { skill, locale, learningLabel } = Astro.props;

const title = skill.title[locale as keyof typeof skill.title];
---

<article
    class="w-full rounded-lg border border-gray-200 bg-white p-6 transition-colors md:w-[calc(50%-0.75rem)] dark:border-white/5 dark:bg-gray-900"
>
    <h3 class="mb-2 text-sm font-semibold">{title}</h3>
    <div class="mb-4 flex flex-wrap gap-2">
        {
            skill.items.map((item) => (
                <span
                    class:list={[
                        "rounded-lg px-2 py-1 text-base font-medium",
                        item.level === "proficient"
                            ? "bg-indigo-100 text-indigo-700 dark:bg-purple-950 dark:text-purple-300"
                            : "border border-indigo-300 text-indigo-400 dark:border-purple-700 dark:text-purple-500",
                    ]}
                >
                    {item.name}
                    {item.level === "learning" ? ` · (${learningLabel})` : ""}
                </span>
            ))
        }
    </div>
</article>
