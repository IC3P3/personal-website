---
import type { CollectionEntry } from "astro:content";

interface Props {
    entry: CollectionEntry<"experience">["data"];
    currentLabel: string;
}

const { entry, currentLabel } = Astro.props;
const { title, organization, location, start, end } = entry;
const timeRange = end ? `${start} - ${end}` : `${start} - ${currentLabel}`;
---

<div data-timeline-entry class="relative pb-10 pl-8 last:pb-0">
    <div
        class="absolute top-1 left-0 h-3 w-3 rounded-full border-2 border-indigo-600 bg-white dark:border-purple-500 dark:bg-gray-950"
    >
    </div>
    <div
        class="absolute top-4 left-1.25 h-full w-0.5 bg-gray-300 last:hidden dark:bg-white/10"
    >
    </div>
    <p class="mb-1 text-sm text-gray-500 dark:text-gray-400">
        {timeRange} · {location}
    </p>
    <h3 class="text-lg font-semibold">{title}</h3>
    <p class="text-gray-600 dark:text-gray-400">{organization}</p>

    <div
        class="mt-2 text-sm text-gray-600 dark:text-gray-400 [&_ul]:list-disc [&_ul]:pl-5"
    >
        <slot />
    </div>
</div>
