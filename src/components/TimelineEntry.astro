---
import type { ExperienceData } from "../types/experience";

interface Props {
    entry: ExperienceData;
    currentLabel: string;
    showMoreLabel: string;
    showLessLabel: string;
    hasDetails?: boolean;
}

const {
    entry,
    currentLabel,
    showMoreLabel,
    showLessLabel,
    hasDetails = false,
} = Astro.props;
const { title, organization, location, start, end, summary } = entry;
const timeRange = end ? `${start} - ${end}` : `${start} - ${currentLabel}`;
---

<div class="relative pb-10 pl-8 last:pb-0">
    <div
        class="absolute top-1 left-0 h-3 w-3 rounded-full border-2 border-indigo-600 bg-white dark:border-purple-500 dark:bg-gray-950"
    >
    </div>
    <div
        class="absolute top-4 left-[5px] h-full w-0.5 bg-gray-300 last:hidden dark:bg-white/10"
    >
    </div>
    <p class="mb-1 text-sm text-gray-500 dark:text-gray-400">
        {timeRange} · {location}
    </p>
    <h3 class="text-lg font-semibold">{title}</h3>
    <p class="text-gray-600 dark:text-gray-400">{organization}</p>

    {
        summary && (
            <ul class="timeline-summary mt-2 list-disc pl-5 text-sm text-gray-600 dark:text-gray-400">
                {summary.map((item) => (
                    <li>{item}</li>
                ))}
            </ul>
        )
    }

    {
        hasDetails && (
            <>
                <div class="timeline-details mt-2 hidden text-sm text-gray-600 dark:text-gray-400 [&_ul]:list-disc [&_ul]:pl-5">
                    <slot />
                </div>
                <button
                    class="timeline-toggle mt-2 text-sm font-medium text-indigo-600 transition-colors hover:text-indigo-800 dark:text-purple-400 dark:hover:text-purple-300"
                    data-show-more={showMoreLabel}
                    data-show-less={showLessLabel}
                >
                    {showMoreLabel}
                </button>
            </>
        )
    }
</div>

<script>
    import "../scripts/timeline-toggle.ts";
</script>
