---
import Social from "./Socials.astro";
import type { Locale } from "../i18n";

interface Props {
    imprintLabel: string;
    privacyLabel: string;
    lastUpdateLabel: string;
    locale: Locale;
}

const { imprintLabel, privacyLabel, lastUpdateLabel, locale } = Astro.props;
const dateLocale = locale === "en" ? "en-GB" : "de-DE";
---

<footer class="mt-20 border-t border-gray-200 dark:border-white/5">
    <div
        class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-6 py-10 md:flex-row md:justify-between"
    >
        <div class="flex items-center gap-3 md:flex-1">
            <Social type="github" link="https://github.com/IC3P3" />
            <Social
                type="linkedin"
                link="https://www.linkedin.com/in/neifler/"
            />
            <Social type="forgejo" link="https://git.eiflerstrom.de" />
            <Social type="email" link="mailto:n.eifler@proton.me" />
        </div>
        <div
            class="flex items-center gap-4 text-sm text-gray-600 md:flex-1 md:justify-center dark:text-gray-400"
        >
            <a
                href="/impressum"
                class="transition-colors hover:text-indigo-600 dark:hover:text-purple-400"
                >{imprintLabel}</a
            >
            <a
                href="/datenschutz"
                class="transition-colors hover:text-indigo-600 dark:hover:text-purple-400"
                >{privacyLabel}</a
            >
        </div>
        <div
            class="text-sm text-gray-500 md:flex-1 md:text-right dark:text-gray-500"
        >
            <p>&copy; {new Date().getFullYear()} Niklas Eifler</p>
            <p class="text-xs">
                {lastUpdateLabel}: {
                    new Date().toLocaleDateString(dateLocale, {
                        day: "2-digit",
                        month: "2-digit",
                        year: "numeric",
                    })
                }
            </p>
        </div>
    </div>
</footer>
