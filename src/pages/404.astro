---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n";

const locale = t("de");

const navContent = {
    title: locale.nav.title,
    items: [{ link: "/", title: locale.nav.startpage }],
};
---

<BaseLayout title={locale.notFound.title} {navContent}>
    <section
        class="flex min-h-[calc(100vh-6rem)] flex-col items-center justify-center text-center"
    >
        <span
            class="mb-4 text-[8rem] leading-none font-bold text-indigo-300/20 md:text-[12rem] dark:text-purple-500/10"
            aria-hidden="true">404</span
        >
        <h1 class="mb-4 text-3xl font-bold md:text-5xl">
            {locale.notFound.heading}
        </h1>
        <p class="mb-8 text-lg text-gray-500 dark:text-gray-400">
            {locale.notFound.text}
        </p>
        <a
            href="/"
            class="rounded-lg bg-indigo-600 px-6 py-3 font-medium text-white transition-colors hover:bg-indigo-700 dark:bg-purple-600 dark:hover:bg-purple-700"
        >
            {locale.notFound.back}
        </a>
    </section>
</BaseLayout>
