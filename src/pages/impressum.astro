---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n";

const locale = t("de");

const navContent = {
    title: locale.nav.title,
    items: [{ link: "/", title: locale.nav.startpage }],
};
---

<BaseLayout title={`${locale.imprint.title} | Niklas Eifler`} {navContent}>
    <section class="prose prose-gray dark:prose-invert mx-auto max-w-3xl py-20">
        <h1>{locale.imprint.title}</h1>

        <h2>{locale.imprint.responsible}</h2>
        <p>
            Niklas Eifler<br />
            <span class="contact-street"></span><br />
            <span class="contact-city"></span>
        </p>

        <h2>{locale.imprint.contact}</h2>
        <p>
            {locale.imprint.phone}: <span class="contact-phone"></span><br />
            {locale.imprint.mail}: <span class="contact-mail"></span>
        </p>

        <h2>{locale.imprint.liable}</h2>
        <p>
            Niklas Eifler<br />
            <span class="contact-street"></span><br />
            <span class="contact-city"></span>
        </p>

        <h2>{locale.imprint.dispute}</h2>
        <p>{locale.imprint.disputeText}</p>

        <h2>{locale.imprint.disclaimer.title}</h2>
        <h3>{locale.imprint.disclaimer.content}</h3>
        <p>{locale.imprint.disclaimer.contentText}</p>

        <h3>{locale.imprint.disclaimer.links}</h3>
        <p>{locale.imprint.disclaimer.linksText}</p>

        <h3>{locale.imprint.disclaimer.copyright}</h3>
        <p>{locale.imprint.disclaimer.copyrightText}</p>
    </section>
</BaseLayout>
