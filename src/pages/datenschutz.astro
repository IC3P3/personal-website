---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n";

const locale = t("de");

const navContent = {
    title: locale.nav.title,
    items: [{ link: "/", title: locale.nav.startpage }],
};
---

<BaseLayout title={`${locale.privacy.title} | Niklas Eifler`} {navContent}>
    <section class="prose prose-gray dark:prose-invert mx-auto max-w-3xl py-20">
        <h1>{locale.privacy.title}</h1>

        <h2>{locale.privacy.responsible}</h2>
        <p>
            {locale.privacy.responsibleText}
        </p>
        <p>
            Niklas Eifler<br />
            STRASSE HAUSNUMMER<br />
            PLZ ORT<br />
            E-Mail: n.eifler@proton.me
        </p>

        <h2>{locale.privacy.general}</h2>
        <p>{locale.privacy.generalText}</p>

        <h2>{locale.privacy.hosting}</h2>
        <p>{locale.privacy.hostingText}</p>

        <h2>{locale.privacy.rights}</h2>
        <p>{locale.privacy.rightsText}</p>
    </section>
</BaseLayout>
