---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n";

const locale = t("de");

const navContent = {
    title: locale.nav.title,
    items: [{ link: "/", title: locale.nav.startpage }],
};
---

<BaseLayout title={`${locale.footer.privacy} | Niklas Eifler`} {navContent}>
    <section class="prose prose-gray dark:prose-invert mx-auto max-w-3xl py-20">
        <h1>{locale.footer.privacy}</h1>
        <p>Inhalt folgt.</p>
    </section>
</BaseLayout>
