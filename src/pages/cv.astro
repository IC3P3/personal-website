---
import "@fontsource-variable/inter";
import { getCollection } from "astro:content";
import { t } from "../i18n";

const locale = t("de");

const allExperience = (await getCollection("experience"))
    .filter((entry) => entry.data.locale === "de")
    .sort((first, second) => first.data.order - second.data.order);

const work = allExperience.filter((entry) => entry.data.type === "work");
const education = allExperience.filter(
    (entry) => entry.data.type === "education",
);
---

<html lang="de">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{locale.cv.title} - Niklas Eifler</title>
        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Inter Variable", sans-serif;
                color: #1a1a1a;
                line-height: 1.6;
                max-width: 800px;
                margin: 0 auto;
                padding: 2rem;
                font-size: 0.9375rem;
            }

            /* Header */
            .cv-header {
                display: flex;
                align-items: flex-start;
                gap: 1.5rem;
                margin-bottom: 0.5rem;
            }

            .cv-header h1 {
                font-size: 2rem;
                font-weight: 700;
                color: #2b6a8a;
            }

            .cv-header .accent {
                display: inline-block;
                width: 0;
                height: 0;
                border-top: 12px solid transparent;
                border-bottom: 12px solid transparent;
                border-left: 16px solid #2b6a8a;
                margin-right: 0.5rem;
                vertical-align: middle;
            }

            .cv-photo {
                width: 120px;
                height: 150px;
                object-fit: cover;
                margin-left: auto;
                flex-shrink: 0;
            }

            /* Sections */
            section {
                margin-bottom: 1.25rem;
            }

            section h2 {
                font-size: 1.125rem;
                font-weight: 400;
                color: #2b6a8a;
                border-bottom: 2px solid #2b6a8a;
                padding-bottom: 0.25rem;
                margin-bottom: 0.75rem;
            }

            /* Two-column rows */
            .row {
                display: grid;
                grid-template-columns: 160px 1fr;
                gap: 0.25rem 1.5rem;
                margin-bottom: 0.25rem;
            }

            .row-label {
                color: #555;
                font-size: 0.875rem;
            }

            .row-value {
                font-size: 0.9375rem;
            }

            /* Experience entries */
            .entry {
                display: grid;
                grid-template-columns: 160px 1fr;
                gap: 0 1.5rem;
                margin-bottom: 1rem;
            }

            .entry-date {
                color: #555;
                font-size: 0.875rem;
                padding-top: 0.1rem;
            }

            .entry-content {
                min-width: 0;
            }

            .entry-org {
                font-weight: 700;
            }

            .entry-title {
                color: #555;
                margin-bottom: 0.25rem;
            }

            .entry-bullets {
                padding-left: 1.25rem;
                margin-top: 0.25rem;
            }

            .entry-bullets li {
                margin-bottom: 0.15rem;
                font-size: 0.875rem;
            }
        </style>
    </head>
    <body>
        <div class="cv-header">
            <div>
                <h1><span class="accent"></span>{locale.cv.title}</h1>
            </div>
            <img class="cv-photo" src="/photo.jpg" alt="Niklas Eifler" />
        </div>

        <section>
            <h2>{locale.cv.personalData}</h2>
            <div class="row">
                <span class="row-label">{locale.cv.name}</span>
                <span class="row-value">Niklas Eifler</span>
            </div>
            <div class="row">
                <span class="row-label">{locale.cv.birthday}</span>
                <span class="row-value">02.12.2001</span>
            </div>
            <div class="row">
                <span class="row-label">{locale.cv.address}</span>
                <span class="row-value"
                    >Im Rottlande 15<br />38350 Helmstedt</span
                >
            </div>
            <div class="row">
                <span class="row-label">{locale.cv.phone}</span>
                <span class="row-value">01514 4697737</span>
            </div>
            <div class="row">
                <span class="row-label">{locale.cv.email}</span>
                <span class="row-value">n.eifler@proton.me</span>
            </div>
        </section>

        {
            work.length > 0 && (
                <section>
                    <h2>{locale.cv.experience}</h2>
                    {work.map((entry) => {
                        const dateLabel = entry.data.end
                            ? `${entry.data.start} - ${entry.data.end}`
                            : `${locale.cv.since} ${entry.data.start}`;
                        return (
                            <div class="entry">
                                <span class="entry-date">{dateLabel}</span>
                                <div class="entry-content">
                                    <div class="entry-org">
                                        {entry.data.organization} in{" "}
                                        {entry.data.location}
                                    </div>
                                    <div class="entry-title">
                                        {entry.data.title}
                                    </div>
                                    {entry.data.cv && (
                                        <ul class="entry-bullets">
                                            {entry.data.cv.map((item) => (
                                                <li>{item}</li>
                                            ))}
                                        </ul>
                                    )}
                                </div>
                            </div>
                        );
                    })}
                </section>
            )
        }

        {
            education.length > 0 && (
                <section>
                    <h2>{locale.cv.education}</h2>
                    {education.map((entry) => {
                        const dateLabel = entry.data.end
                            ? `${entry.data.start} - ${entry.data.end}`
                            : `${locale.cv.since} ${entry.data.start}`;
                        return (
                            <div class="entry">
                                <span class="entry-date">{dateLabel}</span>
                                <div class="entry-content">
                                    <div class="entry-org">
                                        {entry.data.organization} in{" "}
                                        {entry.data.location}
                                    </div>
                                    <div class="entry-title">
                                        {entry.data.title}
                                    </div>
                                    {entry.data.cv && (
                                        <ul class="entry-bullets">
                                            {entry.data.cv.map((item) => (
                                                <li>{item}</li>
                                            ))}
                                        </ul>
                                    )}
                                </div>
                            </div>
                        );
                    })}
                </section>
            )
        }

        <section>
            <h2>{locale.cv.skills}</h2>
            <div class="row">
                <span class="row-label">{locale.cv.languages}</span>
                <span class="row-value">
                    Deutsch (Muttersprache)<br />
                    Englisch (fließend)<br />
                    Französisch (Grundkenntnisse)
                </span>
            </div>
            <div class="row">
                <span class="row-label">{locale.cv.hobbies}</span>
                <span class="row-value">
                    Heimserver-Administration (Docker, Self-Hosting, Reverse
                    Proxy), Konzertchor
                </span>
            </div>
        </section>
    </body>
</html>
